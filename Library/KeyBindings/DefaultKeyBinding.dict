{
    /* 上下左右移動 (vimの hjkl) */
    "^h" = "moveLeft:";
    "^j" = "moveDown:";
    "^k" = "moveUp:";
    "^l" = "moveRight:";

    /* 単語単位の移動 (vimの w/b) */
    "^w" = "moveWordForward:";
    "^b" = "moveWordBackward:";

    /* 行頭・行末 (vimの 0/$) */
    "^0" = "moveToBeginningOfLine:";
    "^$4" = "moveToEndOfLine:";

    /* 文字削除 (vimの x/X) */
    "^x" = "deleteForward:";
    "^$x" = "deleteBackward:";
}
